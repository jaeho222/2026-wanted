{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Comments (계약서 ① : collector → analyzer)",
  "description": "collector가 YouTube URL을 수집·전처리한 뒤 뱉는 정제된 댓글 리스트. analyzer는 이 형식만 입력으로 받는다.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "text", "likes", "time"],
    "properties": {
      "id":    { "type": "string", "description": "댓글 고유 id (예: cmt_001)" },
      "text":  { "type": "string", "description": "정제된 댓글 본문" },
      "likes": { "type": "integer", "description": "좋아요 수" },
      "time":  { "type": "string", "format": "date-time", "description": "작성 시각 ISO8601" }
    }
  },
  "examples": [
    [
      { "id": "cmt_001", "text": "가격이 너무 올랐다", "likes": 1241, "time": "2026-01-10T12:00:00Z" },
      { "id": "cmt_002", "text": "환율 생각하면 이 정도는 납득됨", "likes": 532, "time": "2026-01-10T12:03:00Z" }
    ]
  ]
}
